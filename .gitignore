/target
.DS_Store

# Robot meshes are fetched, not committed: see tools/fetch_robot_meshes.py
data/g1/meshes/

# Checkpoints are run artifacts, not source.
/runs

# Built by scripts/setup-zealot.sh: upstream checkouts, never edited or committed.
zealot-stack/

# Checkpoints written by the zealot backend.
*.safetensors
*.safetensors.best

# Scene library and recordings — user data, not source.
scenes/
curriculum.safetensors

# MuJoCo sim2sim stack (venv, playground, menagerie meshes)
mujoco-stack/

# Pinned upstream trainers and their Python environments.
training-stack/
tools/training/__pycache__/

# Makepad Studio local terminal and debugging state.
/.makepad/

# Workspace writer lock, migration backups and generated policy bundles.
/.studio-workspace.lock
/studio-workspace.*.backup.json
/studio-workspace.json.tmp
/exports/
/simulations/
/evaluations/

/deployments/
tools/deploy/__pycache__/
tools/jobs/__pycache__/

